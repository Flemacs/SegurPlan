	<query language="SQL"><![CDATA[SELECT p.id_prevision,
       u.nombres || ' ' || u.apellidos AS usuario,
       p.fecha_registro,
       p.edad,
       p.ingreso_mensual,
       p.anios_aporte,
       p.monto_pension_estimado,
       p.estado
FROM prevision p
JOIN usuario u ON u.id_usuario = p.id_usuario
WHERE p.tipo_sistema = 'AFP'
ORDER BY p.fecha_registro DESC]]></query>
