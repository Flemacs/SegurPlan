<jasperReport name="rep-dg-02-indicadores" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="60d6061c-8575-4559-b38b-38f4a7b6e13b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SegurPlan"/>
	<query language="SQL"><![CDATA[SELECT 'Total cotizaciones' AS indicador,
       COUNT(*) AS valor,
       'Cotizaciones registradas' AS referencia
FROM cotizacion

UNION ALL

SELECT 'Cotizaciones aceptadas', COUNT(*), 'Estado Aceptada'
FROM cotizacion
WHERE estado = 'Aceptada'

UNION ALL

SELECT 'Prima total', COALESCE(SUM(prima), 0), 'Suma de primas de pólizas'
FROM poliza

UNION ALL

SELECT 'Pólizas vigentes', COUNT(*), 'Estado Vigente'
FROM poliza
WHERE estado = 'Vigente'

UNION ALL

SELECT 'Total siniestros', COUNT(*), 'Siniestros registrados'
FROM siniestro

UNION ALL

SELECT 'Total AFP', COUNT(*), 'Registros AFP'
FROM prevision
WHERE tipo_sistema = 'AFP']]></query>
