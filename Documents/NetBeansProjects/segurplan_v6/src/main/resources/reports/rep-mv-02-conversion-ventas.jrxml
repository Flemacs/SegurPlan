	<query language="SQL"><![CDATA[SELECT c.id_cotizacion,
       c.fecha_solicitud,
       c.fecha_respuesta,
       c.estado,
       ct.id_contratacion,
       ct.estado AS estado_contratacion,
       p.numero_poliza,
       p.estado AS estado_poliza
FROM cotizacion c
LEFT JOIN contratacion ct ON ct.id_cotizacion = c.id_cotizacion
LEFT JOIN poliza p ON p.id_contratacion = ct.id_contratacion
ORDER BY c.fecha_solicitud DESC]]></query>
