	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SegurPlan"/>
	<query language="SQL"><![CDATA[SELECT 'Cotizaciones' AS modulo, COUNT(*) AS total
FROM cotizacion
UNION ALL
SELECT 'Siniestros', COUNT(*)
FROM siniestro
UNION ALL
SELECT 'AFP', COUNT(*)
FROM prevision
WHERE tipo_sistema = 'AFP']]></query>
