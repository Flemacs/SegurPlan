	<query language="SQL"><![CDATA[SELECT h.fecha_hora,
       COALESCE(u.nombres || ' ' || u.apellidos, 'Sistema') AS usuario,
       h.entidad,
       h.id_registro,
       h.accion,
       h.valor_anterior,
       h.valor_nuevo
FROM historial h
LEFT JOIN usuario u ON u.id_usuario = h.id_usuario
ORDER BY h.fecha_hora DESC]]></query>
