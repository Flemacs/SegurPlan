<jasperReport name="rep-po-03-siniestros-aseguradora" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="467a1e4f-9f86-44c2-8f78-721c567b6f8e">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SegurPlan"/>
	<query language="SQL"><![CDATA[SELECT a.nombre AS aseguradora,
       (SELECT COUNT(*) FROM siniestro s
        WHERE s.id_aseguradora = a.id_aseguradora) AS total,
       (SELECT COUNT(*) FROM siniestro s
        WHERE s.id_aseguradora = a.id_aseguradora
          AND s.estado = 'Aprobado') AS aprobados,
       (SELECT COUNT(*) FROM siniestro s
        WHERE s.id_aseguradora = a.id_aseguradora
          AND s.estado = 'Rechazado') AS rechazados,
       (SELECT COUNT(*) FROM siniestro s
        WHERE s.id_aseguradora = a.id_aseguradora
          AND s.estado = 'Observado') AS observados,
       (SELECT COUNT(*) FROM siniestro s
        WHERE s.id_aseguradora = a.id_aseguradora
          AND s.resultado_evaluacion IS NOT NULL
          AND TRIM(s.resultado_evaluacion) <> '') AS con_resultado
FROM aseguradora a
ORDER BY a.nombre]]></query>
