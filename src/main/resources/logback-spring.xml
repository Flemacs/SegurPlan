<?xml version="1.0" encoding="UTF-8"?>
<!--
  SegurPlan - Configuración de Logback (Spring Boot la detecta automáticamente)

  - SLF4J como fachada y Logback como implementación (spring-boot-starter-logging).
  - Salida a consola y a archivo con rotación por día y por tamaño.
  - Retención: 30 días y tope total de 500 MB; los archivos viejos se comprimen (.gz).
  - Escritura de archivo asíncrona para no frenar las peticiones.
  - Carpeta de logs fuera del código: variable de entorno LOG_DIR (por defecto ./logs).
  - No se registran credenciales ni contenido de archivos: solo metadatos.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DIR" value="${LOG_DIR:-./logs}"/>
    <property name="LOG_FILE_NAME" value="segurplan"/>
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- Consola (desarrollo) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Archivo con rotación diaria y por tamaño -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Escritura asíncrona hacia el archivo -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- Código de la aplicación -->
    <logger name="com.segurplan" level="INFO"/>

    <!-- Ruido de frameworks -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

</configuration>
