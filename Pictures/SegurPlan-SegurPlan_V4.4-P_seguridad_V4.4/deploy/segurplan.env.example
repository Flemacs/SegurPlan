# Copiar a /etc/segurplan.env (chmod 600, dueño root) y ajustar. No subir a Git.
DB_URL=jdbc:postgresql://localhost:5432/SegurPlan
DB_USER=postgres
DB_PASSWORD=cambie_esta_clave
PORT=8080
COOKIE_SECURE=true
SWAGGER_ENABLED=false
SPRING_PROFILES_ACTIVE=prod
LOG_DIR=/var/log/segurplan
BACKUP_DIR=/opt/segurplan/backups
PG_BIN_DIR=
