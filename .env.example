# Copie este archivo a ".env" y ajuste los valores (docker compose lo lee solo).
# DB_PASSWORD es OBLIGATORIA: use una clave larga y propia.
DB_PASSWORD=cambie_esta_clave
PORT=8080
# true cuando se publique con HTTPS (marca la cookie de sesión como Secure)
COOKIE_SECURE=false
# true = Swagger UI disponible en /swagger-ui.html (desarrollo y pruebas)
# false = oculto (recomendado en producción)
SWAGGER_ENABLED=true
